# Prepared mode needs no configuration. Live AI is disabled by default.
# Keep real values in .env.local or server deployment settings, never VITE_*.
RULEBREAKER_LIVE_AI_ENABLED=false
RULEBREAKER_OPERATOR_BEARER_TOKEN=
RULEBREAKER_AI_API_KEY=
RULEBREAKER_AI_BASE_URL=https://api.openai.com/v1
RULEBREAKER_AI_MODEL=gpt-4o-mini
# Development-only loopback providers; production always requires HTTPS.
RULEBREAKER_AI_ALLOW_LOCAL_HTTP=false
